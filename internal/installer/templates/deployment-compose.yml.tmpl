# Zoomies, deployed with Docker Compose.
#
# Written by `zoomies init`. Every value this reads is in the .env file beside
# it, already filled in -- there is nothing to edit here before it will run.
{{- if ne .Command "agent" }}
# The controller's settings are in its database, and change on its settings
# page; this file and .env only start it:
{{- end }}
#
#     docker compose up -d
#
{{if eq .Command "agent" -}}
# The .env holds this host's agent token, so it is mode 0600 and belongs in
# neither a repository nor a backup that anyone can read. This file has no
# secrets in it and is safe to keep under version control.
{{- else -}}
# The .env holds the instance encryption key, so it is mode 0600 and belongs in
# neither a repository nor a backup that anyone can read. This file has no
# secrets in it and is safe to keep under version control.
{{- end}}

name: zoomies

services:
  zoomies:
    image: ${ZOOMIES_IMAGE}
    restart: unless-stopped
    # Finish admitted runner creation before replacing the service.
    stop_grace_period: 20m
    container_name: {{.Container}}
    # The last segment of the name the embedded agent registers this host
    # under, which is otherwise derived from what the machine is:
    # zoomies-8vcpu-32gb-ubuntu-2404-<this>. Without the line that segment is
    # the container's random twelve-hex-digit ID, which then follows the host
    # into every scheduler reason and problem message. A dedicated agent does
    # not rely on it -- it is told its whole name outright, because this line
    # reads the same on every machine running this file.
    hostname: {{.Container}}
    command: ["{{.Command}}"]
    environment:
{{- if eq .Command "agent" }}
      # The controller this host takes work from, and the token it joins with
      # the first time it starts. The join writes a lasting credential into the
      # state volume, so the token is spent once and every later start reads
      # the volume instead.
      ZOOMIES_CONTROLLER_URL: ${ZOOMIES_CONTROLLER_URL:?set this in .env}
      ZOOMIES_JOIN_TOKEN: ${ZOOMIES_JOIN_TOKEN:?set this in .env}
      # Set explicitly because this container's hostname is the same on every
      # machine that runs this file, and the name is derived from it.
      ZOOMIES_AGENT_NAME: ${ZOOMIES_AGENT_NAME:?set this in .env}

      # An agent has no database, so its settings are these.
      ZOOMIES_AGENT_BACKEND: ${ZOOMIES_AGENT_BACKEND}
      ZOOMIES_DOCKER_HOST: ${ZOOMIES_DOCKER_HOST}
      ZOOMIES_AGENT_CAPACITY: ${ZOOMIES_AGENT_CAPACITY}
      # The network runner containers are attached to: the one declared at the
      # bottom of this file. Without it they land on the daemon's default
      # bridge.
      ZOOMIES_AGENT_NETWORK: ${ZOOMIES_AGENT_NETWORK}
      ZOOMIES_WORK_DIR: ${ZOOMIES_WORK_DIR}
      ZOOMIES_LOG_FORMAT: ${ZOOMIES_LOG_FORMAT}
      ZOOMIES_LOG_LEVEL: ${ZOOMIES_LOG_LEVEL}
{{- else }}
      # 32 bytes, base64. Everything secret in the database is sealed with it.
      # Back it up: without it the stored GitHub App key cannot be decrypted.
      ZOOMIES_ENCRYPTION_KEY: ${ZOOMIES_ENCRYPTION_KEY:?set this in .env}
      # Every other setting -- the external URL, TLS, the embedded agent --
      # lives in the database, where the settings page changes it. One named
      # here would override it there, and the page would show it as locked.
{{- end }}

      # Generated run-time data -- a self-signed certificate above all -- goes
      # into the volume, so replacing the container does not change it.
      ZOOMIES_STATE_DIR: ${ZOOMIES_STATE_DIR}
      ZOOMIES_DB_PATH: ${ZOOMIES_DB_PATH}
{{- if .GroupAdd }}

      # The gid group_add below is given, echoed in so that if it is ever
      # wrong the Hosts page can name the line in .env to change.
      DOCKER_GID: ${DOCKER_GID}
{{- end }}
{{- if .Publish }}
    ports:
      # Published as ${ZOOMIES_PUBLISHED_ADDR}:${ZOOMIES_PUBLISHED_PORT}. On
      # 127.0.0.1 only this host and whatever proxies from it can connect; open
      # it wider only once something in front terminates TLS, or put the origin
      # behind a firewall that allows only your proxy's ranges.
      - "${ZOOMIES_PUBLISHED_ADDR}:${ZOOMIES_PUBLISHED_PORT}:{{.ContainerPort}}"
{{- end }}
    volumes:
      - {{.Volume}}:/var/lib/zoomies
{{- if .MountShared }}
      # The shared folder: runners' caches, one folder per purpose, and the
      # place later releases add folders of their own. It is mounted at the
      # path it has on this host, so a folder the controller hands this host's
      # daemon for a runner's mount is the same folder on both sides. Owned by
      # uid 65532, the image's account, so Zoomies can add to it as it runs.
      - {{.SharedDir}}:{{.SharedDir}}
{{- end }}
{{- if .MountSocket }}
      # The embedded agent needs this socket to create runner containers. This
      # is Zoomies' own access to the runtime -- it is NOT the same thing as
      # pool.docker_mode=host-socket, which would hand the socket to your jobs.
      - {{.SocketPath}}:{{.SocketPath}}
{{- end }}
{{- if .TLSCertFile }}
      # The certificate and key are mounted at the same paths they have on this
      # host, which is why the TLS settings can name them directly.
      - {{.TLSCertFile}}:{{.TLSCertFile}}:ro
      - {{.TLSKeyFile}}:{{.TLSKeyFile}}:ro
{{- end }}
{{- if .GroupAdd }}
    # The image runs as uid 65532; that user must be able to use the socket.
    # On most hosts that means adding the docker group's gid here.
    group_add:
      - "${DOCKER_GID}"
{{- end }}
    networks: [zoomies]
{{- if .Healthcheck }}
    healthcheck:
      test: ["CMD", "/usr/local/bin/zoomies", "healthcheck", "--url", "http://127.0.0.1:{{.ContainerPort}}"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 20s
{{- end }}

volumes:
  {{.Volume}}:

networks:
  # Runner containers are attached to this network by the embedded agent, which
  # keeps them off the host network and off the default bridge.
  zoomies:
    name: {{.Network}}
