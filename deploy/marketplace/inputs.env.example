# The inputs a provider collects before it boots this image, and the only
# things about a deployment that differ between one customer and the next.
#
# Copy this file, fill it in, and hand it to render.sh:
#
#     cp inputs.env.example inputs.env
#     ./render.sh inputs.env > cloud-init.yaml
#
# There is deliberately no key here for a GitHub App private key, a webhook
# secret, a registration token or an administrator password. Everything a
# provider's form collects ends up in instance metadata, which is readable by
# anything on the instance that can reach the metadata service and is often
# kept in the provider's own database as well -- so the secure parts of setup
# happen in the browser afterwards, and this file stays boring enough to lose.

# REQUIRED. The DNS name that will point at this instance. Webhook deliveries,
# the session cookie's Secure flag and every link in the UI are built from it,
# and GitHub will not deliver to a name it cannot resolve.
ZOOMIES_HOSTNAME=zoomies.example.com

# The public address browsers and GitHub use. Derived from the hostname, and
# worth setting by hand only when something in front changes the scheme, the
# port or the path -- a load balancer publishing this instance under a
# different name, say.
#ZOOMIES_EXTERNAL_URL=https://zoomies.example.com

# Whether the DNS record above already points at this instance at boot. It does
# not apply to ZOOMIES_TLS=tunnel, where Cloudflare maps the hostname to the
# tunnel and this instance has no record of its own.
#
#   ready    -- the A or AAAA record exists now
#   pending  -- it is created after the instance has an address, which is the
#               usual order when the provider assigns one at boot
#
# Nothing in the bootstrap can create the record, and the honest difference is
# what it promises afterwards: with "pending" the instance comes up ready to
# serve that name and says in its first-login notes what still has to happen.
ZOOMIES_DNS=pending

# Who holds the certificate for the public name.
#
#   acme       -- a small reverse proxy on this instance asks Let's Encrypt for
#                 one and renews it. Needs the DNS record below to point here
#                 and ports 80 and 443 reachable.
#   tunnel     -- a Cloudflare Tunnel. A daemon on this instance dials out and
#                 Cloudflare serves HTTPS, so there is no inbound rule, no DNS
#                 record of this machine's own and no certificate here. The
#                 arrangement for a home network, somebody else's firewall, or
#                 a provider that charges for a static address.
#   cloudflare -- Cloudflare in front of a published origin: this instance
#                 serves plain HTTP on port 80 and Cloudflare proxies to it.
#                 Firewall port 80 to Cloudflare's ranges, or the origin is
#                 reachable directly and the edge is merely in front of it.
#   files      -- you already have a certificate, from the provider or anywhere
#                 else. Zoomies serves it itself and is published on 443.
#   off        -- something else in front terminates TLS: a load balancer of
#                 the provider's, or a proxy you run. ZOOMIES_TRUSTED_PROXIES
#                 has to name it.
#
# Three of these leave the controller speaking plain HTTP, and that is correct:
# the origin is not the public endpoint. What has to be HTTPS is the address in
# ZOOMIES_EXTERNAL_URL -- GitHub will not deliver webhooks to anything else and
# the session cookie cannot be marked Secure without it.
ZOOMIES_TLS=acme

# Where Let's Encrypt sends expiry warnings, for ZOOMIES_TLS=acme. Optional,
# and worth setting: without it the only warning of a renewal that stopped
# working is the outage.
#ZOOMIES_ACME_EMAIL=ops@example.com

# For ZOOMIES_TLS=tunnel, the token from the Cloudflare dashboard, for the
# tunnel whose public hostname points at http://127.0.0.1:8080.
#
# Leave it empty, which is the better shape. The instance is rendered ready
# either way, and an empty one means the token never passes through instance
# metadata, the provider's database or cloud-init's log -- the first-login
# notes say where to paste it over SSH and which single command starts the
# tunnel. Set it only when a form has to produce a working instance unattended,
# knowing where the token ends up.
#ZOOMIES_TUNNEL_TOKEN=

# For ZOOMIES_TLS=files, the certificate this instance serves and its key, as
# paths on the instance. The deployment mounts them read-only into the
# container at the same paths.
#ZOOMIES_TLS_CERT_FILE=/etc/zoomies/tls/fullchain.pem
#ZOOMIES_TLS_KEY_FILE=/etc/zoomies/tls/privkey.pem

# The address the controller is published on. Left unset, the arrangement
# decides: loopback for anything that reaches it from this instance, and every
# interface for ZOOMIES_TLS=cloudflare, whose edge connects from outside.
# Set it only when the proxy is elsewhere and a firewall stands between.
#ZOOMIES_PUBLISH_ADDR=127.0.0.1

# CIDRs whose X-Forwarded-For header is believed, or the word cloudflare for
# Cloudflare's published ranges. Without this every audit entry records the
# proxy's address and the login rate limiter throttles the whole internet as
# one caller.
#
# Left unset, the arrangement decides: loopback for acme, tunnel and a proxy on
# this instance -- a tunnel included, where the peer is the local daemon rather
# than Cloudflare's edge -- and the word cloudflare for ZOOMIES_TLS=cloudflare.
#ZOOMIES_TRUSTED_PROXIES=127.0.0.1/32,::1/128

# What this instance runs.
#
#   single     -- the controller and an agent, so the instance can run jobs on
#                 its own from the first minute
#   controller -- the controller alone; every runner host joins from elsewhere
ZOOMIES_MODE=single

# The controller image. Defaults to the pinned reference in release.env, which
# is the tested one; override it only to run a private mirror of that digest.
#ZOOMIES_CONTROLLER_IMAGE=

# Where the database, the encryption key and the runners' work area live. This
# is the directory to put on a provider's attached volume, and the directory a
# backup copies.
ZOOMIES_DATA_DIR=/var/lib/zoomies

# How the first administrator is created. The only supported value is the one
# that needs no secret in instance metadata: the controller prints a setup
# token in its log while no account exists, and the browser form asks for it.
ZOOMIES_ADMIN_BOOTSTRAP=setup-token
