# The inputs a provider collects before it boots this image, and the only
# things about a deployment that differ between one customer and the next.
#
# Copy this file, fill it in, and hand it to render.sh:
#
#     cp inputs.env.example inputs.env
#     ./render.sh inputs.env > cloud-init.yaml
#
# There is deliberately no key here for a GitHub App private key, a webhook
# secret, a registration token or an administrator password. Everything a
# provider's form collects ends up in instance metadata, which is readable by
# anything on the instance that can reach the metadata service and is often
# kept in the provider's own database as well -- so the secure parts of setup
# happen in the browser afterwards, and this file stays boring enough to lose.

# REQUIRED. The DNS name that will point at this instance. Webhook deliveries,
# the session cookie's Secure flag and every link in the UI are built from it,
# and GitHub will not deliver to a name it cannot resolve.
ZOOMIES_HOSTNAME=zoomies.example.com

# The public address browsers and GitHub use. Derived from the hostname, and
# worth setting by hand only when something in front changes the scheme, the
# port or the path -- a load balancer publishing this instance under a
# different name, say.
#ZOOMIES_EXTERNAL_URL=https://zoomies.example.com

# Whether the DNS record above already points at this instance at boot.
#
#   ready    -- the A or AAAA record exists now
#   pending  -- it is created after the instance has an address, which is the
#               usual order when the provider assigns one at boot
#
# Nothing in the bootstrap can create the record, and the honest difference is
# what it promises afterwards: with "pending" the instance comes up ready to
# serve that name and says in its first-login notes what still has to happen.
ZOOMIES_DNS=pending

# How this deployment gets its certificate. Only "off" is implemented by this
# slice: the instance publishes plain HTTP for a load balancer or reverse proxy
# in front of it to terminate, and ZOOMIES_TRUSTED_PROXIES has to name that
# proxy or every audit row records it instead of the real client.
ZOOMIES_TLS=off

# The address the controller is published on when TLS is terminated elsewhere.
# Loopback is the safe default and assumes the proxy runs on this instance;
# widen it only when the proxy is somewhere else and a firewall stands between.
ZOOMIES_PUBLISH_ADDR=127.0.0.1

# CIDRs whose X-Forwarded-For header is believed. Without this every audit entry
# records the proxy's address and the login rate limiter throttles the whole
# internet as one caller.
ZOOMIES_TRUSTED_PROXIES=127.0.0.1/32,::1/128

# What this instance runs.
#
#   single     -- the controller and an agent, so the instance can run jobs on
#                 its own from the first minute
#   controller -- the controller alone; every runner host joins from elsewhere
ZOOMIES_MODE=single

# The controller image. Defaults to the pinned reference in release.env, which
# is the tested one; override it only to run a private mirror of that digest.
#ZOOMIES_CONTROLLER_IMAGE=

# Where the database, the encryption key and the runners' work area live. This
# is the directory to put on a provider's attached volume, and the directory a
# backup copies.
ZOOMIES_DATA_DIR=/var/lib/zoomies

# How the first administrator is created. The only supported value is the one
# that needs no secret in instance metadata: the controller prints a setup
# token in its log while no account exists, and the browser form asks for it.
ZOOMIES_ADMIN_BOOTSTRAP=setup-token
