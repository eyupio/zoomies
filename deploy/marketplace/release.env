# The release this deployment package installs, and how its pieces are pinned.
#
# A marketplace artefact is not a place for a floating tag. Someone deploys it
# months after it was published, and `latest` would hand them a controller that
# was never tested against this bootstrap -- so everything here names one
# release, and images.lock beside it records the digest each tag resolved to on
# the day that release was cut.
#
# Update this file when a newer release becomes the package's baseline, and run
# `make marketplace-lock` to refresh images.lock with it. A test in
# internal/docs checks the two still agree with each other and with the runner
# catalogue in internal/naming, so a new operating system cannot be published
# and then quietly left out of the package.

# The release the bootstrap installs. install.sh is given this as --version,
# which is also what it verifies the downloaded binary's SHA-256 against.
ZOOMIES_RELEASE=v1.2.0

# The controller image, pinned by tag and by digest. Docker accepts both in one
# reference: the tag is for whoever reads `docker ps`, the digest is what is
# actually pulled, and a moved tag cannot change it.
ZOOMIES_CONTROLLER_IMAGE=ghcr.io/eyupio/zoomies:v1.2.0@sha256:48e3c17c524c71f5891a75cb2bbc398615ec06f96d48bfa7102d524a587f0d38

# What a runner host is told to install when it joins this controller. An agent
# newer than its controller is unsupported (docs/upgrading.md), and a
# marketplace deployment is exactly where that would happen by accident -- the
# controller is pinned and the join command is copied months later -- so the
# generated join line carries this version rather than tracking the newest
# release. An operator who wants a different one passes --version themselves.
ZOOMIES_AGENT_VERSION=v1.2.0

# Where the runner images live. The bootstrap never picks one: a pool's runner
# image is resolved by the controller from the tag its own image was built
# with, so a v1.0.0 controller starts v1.0.0 runners and pinning the controller
# pins the whole set. These are here because a package that records its images
# should name all of them, and because an air-gapped mirror needs the
# repositories rather than any single tag.
ZOOMIES_RUNNER_REPO=ghcr.io/eyupio/zoomies-runner
ZOOMIES_RUNNER_DOCKER_REPO=ghcr.io/eyupio/zoomies-runner-docker

# The installer the bootstrap runs, pinned to the same release and verified
# before it is executed. A marketplace instance fetches this over the network
# on first boot, which is the one moment nobody is watching -- so it is fetched
# from the release tag rather than from a channel that moves, and a checksum
# mismatch stops the boot rather than installing whatever arrived.
ZOOMIES_INSTALLER_URL=https://raw.githubusercontent.com/eyupio/zoomies/v1.2.0/install.sh
ZOOMIES_INSTALLER_SHA256=ea0d6956193ffb89e9f3ffda723a3520b6af1cdf3a46ad770e19fdb4eb8cca68

# The reverse proxy an ACME deployment runs in front of the controller. Zoomies
# terminates TLS itself when it is given a certificate, so this is here for the
# one case it cannot cover: getting a certificate automatically, with no
# Cloudflare and no certificate to hand. Pinned like everything else -- it sits
# in front of the whole instance.
ZOOMIES_PROXY_IMAGE=caddy:2-alpine@sha256:de23def33b17fb5d1290b0f6c2add1d70780e52341896c00a4c8a2a2fe9d355e

# The tunnel daemon, for a deployment that publishes no port at all. It dials
# out to Cloudflare and Cloudflare serves HTTPS, so the instance needs no
# inbound rule, no DNS record of its own and no certificate -- which is the
# arrangement for a machine on a home network or behind somebody else's
# firewall. Pinned like everything else: it terminates nothing, but every
# request to this deployment passes through it.
ZOOMIES_TUNNEL_IMAGE=cloudflare/cloudflared:2026.9.1@sha256:b269e8abd07a5bf6f3f4be65d5050b2174eca89c56a0241a8ff32a16aec454e4
